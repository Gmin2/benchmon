{
  "name": "benchmon-backend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch --env-file=../.env --env-file=.env src/index.ts",
    "local": "bun --env-file=../.env --env-file=.env src/index.ts",
    "start": "bun src/index.ts",
    "push-stats": "bun --env-file=../.env --env-file=.env scripts/push-stats.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "viem": "^2.56.9"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "hyparquet": "^1.31.2",
    "typescript": "^7.0.2"
  }
}
